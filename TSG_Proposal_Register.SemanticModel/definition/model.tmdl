model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Proactive Proposal Tracking","Identified By Source","Last Refresh"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Proactive Proposal Tracking'
ref table 'Identified By Source'
ref table 'Last Refresh'

ref cultureInfo en-US

