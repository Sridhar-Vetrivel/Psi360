table 'Proactive Proposal Tracking'
	lineageTag: c425f1ac-fbeb-41d1-9e02-f8205a2f935d

	/// Number of opportunities in the current filter context (blank when none). Used by the charts.
	measure Opportunities = COUNTROWS('Proactive Proposal Tracking')
		formatString: #,0
		displayFolder: Counts
		lineageTag: 30ef16ea-4324-4c76-9f54-a4e52fa5a629

	measure 'Total Opportunities' = [Opportunities] + 0
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 07526ebd-62f3-445d-8baa-6b04ac0b6c6d

	/// Status is In Progress or Proposed.
	measure 'Active Pipeline' =
			CALCULATE (
				[Opportunities],
				KEEPFILTERS ( 'Proactive Proposal Tracking'[Status] IN { "In Progress", "Proposed" } )
			) + 0
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 88eb5600-8bc8-448d-838d-dce6a6d362c5

	measure 'High Priority Active' =
			CALCULATE (
				[Opportunities],
				KEEPFILTERS ( 'Proactive Proposal Tracking'[Status] IN { "In Progress", "Proposed" } ),
				KEEPFILTERS ( 'Proactive Proposal Tracking'[Priority] = "High" )
			) + 0
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 9e19e5e5-225f-4590-9652-29bc3011000e

	measure Won = CALCULATE ( [Opportunities], KEEPFILTERS ( 'Proactive Proposal Tracking'[Status] = "Won" ) ) + 0
		formatString: #,0
		displayFolder: KPIs
		lineageTag: cc081f27-0930-4d9f-92ad-3a507b237bb9

	measure 'On Hold' = CALCULATE ( [Opportunities], KEEPFILTERS ( 'Proactive Proposal Tracking'[Status] = "On Hold" ) ) + 0
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 9a38652c-0c54-4df2-b82b-b08f3d1f0a4e

	measure Closed = CALCULATE ( [Opportunities], KEEPFILTERS ( 'Proactive Proposal Tracking'[Status] = "Closed" ) ) + 0
		formatString: #,0
		displayFolder: KPIs
		lineageTag: a9e6bc94-fa4f-4551-bbd2-ae416cc050ef

	/// Won / (Won + Closed). On Hold is excluded because it is not decided yet. Shows a dash when nothing is decided.
	measure 'Win Rate' =
			VAR _won = [Won]
			VAR _closed = [Closed]
			RETURN
				IF ( _won + _closed = 0, "—", FORMAT ( DIVIDE ( _won, _won + _closed ), "0%" ) )
		displayFolder: KPIs
		lineageTag: b818e664-48b1-4829-b7f3-730a9074f833

	measure 'Summary Text' =
			"Of " & FORMAT ( [Total Opportunities], "#,0" ) & " opportunities, "
				& FORMAT ( [Active Pipeline], "#,0" ) & " are active (In Progress or Proposed), "
				& FORMAT ( [Won], "#,0" ) & " are won and "
				& FORMAT ( [On Hold], "#,0" ) & " are on hold."
		displayFolder: Labels
		lineageTag: f060bf72-204c-41e6-85e7-83d7dfc8f0f9

	measure Greeting =
			VAR _upn = USERPRINCIPALNAME ()
			VAR _at = SEARCH ( "@", _upn, 1, 0 )
			VAR _name = IF ( _at > 0, LEFT ( _upn, _at - 1 ), _upn )
			VAR _slash = SEARCH ( "\", _name, 1, 0 )
			RETURN
				"Hi, " & IF ( _slash > 0, MID ( _name, _slash + 1, 200 ), _name )
		displayFolder: Labels
		lineageTag: cb0aa44c-64be-4c64-b3bc-eb608c24ecd0

	measure 'Last Refreshed Text' = "Last Refreshed On " & FORMAT ( MAX ( 'Last Refresh'[Last Refreshed] ), "yyyy-mm-dd HH:mm" )
		displayFolder: Labels
		lineageTag: 395c9d79-fdfc-4bc7-9ff2-f38a4cb545fc

	/// Hex colour per Status, used for conditional formatting in the opportunity list.
	measure 'Status Colour' =
			SWITCH (
				SELECTEDVALUE ( 'Proactive Proposal Tracking'[Status] ),
				"In Progress", "#1E8C91",
				"Proposed", "#0E6B70",
				"On Hold", "#8A8500",
				"Won", "#1AAB40",
				"Closed", "#8A8886",
				"#605E5C"
			)
		displayFolder: Labels
		lineageTag: 2952fe40-172b-4017-9f47-5bd911fa464f

