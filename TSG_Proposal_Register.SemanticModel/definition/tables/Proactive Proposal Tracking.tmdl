	partition 'Proactive Proposal Tracking' = m
		mode: import
		source =
				let
				  Source = Excel.Workbook(Web.Contents("https://psiog0.sharepoint.com/sites/BEACON/Knowledge Hub/TSG/TSG_Proposal_Register.xlsx"), null, true),
				  #"Navigation 1" = Source{[Item = "Proactive Proposal Tracking", Kind = "Sheet"]}[Data],
				  #"Promoted headers" = Table.PromoteHeaders(#"Navigation 1", [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"MAC No.", Int64.Type}, {"MAC Name", type text}, {"Account Name", type text}, {"Opportunity Details", type text}, {"Priority", type text}, {"Type", type text}, {"Engagement", type text}, {"Identified By", type text}, {"Status", type text}, {"Stage", type text}, {"Opportunity Owner", type text}, {"TAC Associate", type text}, {"Next Action / Support Needed", type text}, {"Reusability", type text}}, "en-US"),
				  // Excel row number: header is row 1, so the first data row is row 2
				  #"Added Row" = Table.AddIndexColumn(#"Changed column type", "Row", 2, 1, Int64.Type),
				  TextColumns = {"MAC Name", "Account Name", "Opportunity Details", "Priority", "Type", "Engagement", "Identified By", "Status", "Stage", "Opportunity Owner", "TAC Associate", "Next Action / Support Needed", "Reusability"},
				  // Trim spaces / line breaks and turn empty strings into null
				  #"Cleaned text" = Table.TransformColumns(#"Added Row", List.Transform(TextColumns, (c) => {c, each let t = if _ = null then null else Text.Trim(Text.Clean(Text.From(_))) in if t = "" then null else t, type nullable text})),
				  // Drop rows where every text column is empty
				  #"Removed empty rows" = Table.SelectRows(#"Cleaned text", each List.NonNullCount(Record.ToList(Record.SelectFields(_, TextColumns))) > 0),
				  // Consistent casing for the categories; blanks become "Not set"
				  #"Normalised categories" = Table.TransformColumns(#"Removed empty rows", {
					  {"Status", each if _ = null then "Not set" else Text.Proper(_), type text},
					  {"Priority", each if _ = null then "Not set" else Text.Proper(_), type text},
					  {"Type", each if _ = null then "Not set" else Text.Proper(_), type text},
					  {"Engagement", each if _ = null then "Not set" else Text.Upper(_), type text},
					  {"Opportunity Details", each if _ = null then "Not entered" else _, type text}
				  }),
				  OrderOf = (value as text, order as list) as number => let p = List.PositionOf(order, value) in if p < 0 then 99 else p + 1,
				  #"Added Status Order" = Table.AddColumn(#"Normalised categories", "Status Order", each OrderOf([Status], {"In Progress", "Proposed", "On Hold", "Won", "Closed"}), Int64.Type),
				  #"Added Priority Order" = Table.AddColumn(#"Added Status Order", "Priority Order", each OrderOf([Priority], {"High", "Medium", "Low"}), Int64.Type),
				  #"Added Type Order" = Table.AddColumn(#"Added Priority Order", "Type Order", each OrderOf([Type], {"Proactive", "New Requirement"}), Int64.Type),
				  #"Added Engagement Order" = Table.AddColumn(#"Added Type Order", "Engagement Order", each OrderOf([Engagement], {"EBD", "NBD"}), Int64.Type)
				in
				  #"Added Engagement Order"

	annotation PBI_ResultType = Table

