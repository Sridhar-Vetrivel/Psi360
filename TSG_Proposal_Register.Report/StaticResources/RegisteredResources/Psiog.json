{
  "name": "Psiog",
  "dataColors": [
    "#2DB6BC",
    "#0E6B70",
    "#DCD501",
    "#1AAB40",
    "#A19F9D",
    "#6B007B",
    "#E66C37",
    "#197278",
    "#D64550",
    "#744EC2"
  ],
  "foreground": "#252423",
  "background": "#FFFFFF",
  "tableAccent": "#0E6B70",
  "textClasses": {
    "title": {
      "fontFace": "DIN",
      "fontSize": 14,
      "color": "#252423"
    },
    "callout": {
      "fontFace": "DIN",
      "fontSize": 34,
      "color": "#252423"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "wf_standard-font, helvetica, arial, sans-serif",
            "fontSize": 17,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#252423"
              }
            },
            "alignment": "left"
          }
        ],
        "divider": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0E6B70"
              }
            },
            "width": 4,
            "ignorePadding": true
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0E6B70"
              }
            },
            "radius": 4,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#CCCCCC"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "divider": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "divider": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "divider": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "divider": [
          {
            "show": false
          }
        ]
      }
    }
  }
}